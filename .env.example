# Copy this file to .env and change the values:
#   cp .env.example .env
# Never commit the .env file.

# MySQL (used by the database container)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=garden_control
MYSQL_USER=garden_user
MYSQL_PASSWORD=change_me

# Backend
# Origin allowed by CORS (the frontend URL)
CORS_ORIGIN=http://localhost:8080
# Secret used to sign JWT auth tokens (use a long random value, e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_to_a_long_random_secret

# Note: the backend's Prisma DATABASE_URL is assembled from the MYSQL_* vars
# above by docker-compose, so you only set the pieces here.
